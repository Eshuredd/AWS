CORS_ORIGINS=["http://localhost:3000"]

AWS_PROFILE=ridewatch
AWS_REGION=ap-south-1
AWS_PAGER=

LOCATION_PROVIDER=aws
ROUTE_ESTIMATE_MAX_AGE_SECONDS=300
STORAGE_BACKEND=memory
DYNAMODB_TABLE_NAME=ridewatch-dev

# Credentials stay in your standard AWS profile files, never in this file.
# Omit AWS_PROFILE to use the normal AWS credential provider chain.
# Lambda: do not copy this file; use deployment/lambda-environment.example.json.
# Lambda supplies AWS_REGION and uses its execution role; omit AWS_PROFILE.
# For Amplify add its exact HTTPS origin to the CORS_ORIGINS JSON array.
