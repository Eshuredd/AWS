NEXT_PUBLIC_API_URL=http://localhost:8000
# Amplify: set NEXT_PUBLIC_API_URL to the HTTPS API Gateway origin at build time.
# Use the $default stage; no /api suffix. Rebuild after changing the URL.

# Optional: gives Uber's web/mobile handoff a web fallback.
# Without it, RideWatch uses Uber's documented uber:// ride-request deep link.
NEXT_PUBLIC_UBER_CLIENT_ID=

# Optional: required by Ola's documented partner deep link to prefill pickup/drop.
# Obtain this from Ola partner/developer access. If omitted, RideWatch opens Ola without route prefill.
NEXT_PUBLIC_OLA_XAPP_TOKEN=
